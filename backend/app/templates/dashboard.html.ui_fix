<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>ThreatLens SOC</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Arial,Helvetica,sans-serif;background:#08111f;color:#fff}
.layout{display:grid;grid-template-columns:220px 1fr;min-height:100vh}
.sidebar{background:#0d1728;padding:24px;border-right:1px solid #1f3553}
.logo{font-size:28px;font-weight:bold;color:#39b8ff;margin-bottom:30px}
.logo span{color:#fff}
.menu a{display:block;color:#c8d5e6;text-decoration:none;padding:14px;border-radius:10px;margin-bottom:8px}
.menu a:hover,.active{background:#14396a;color:#fff}
.main{padding:22px}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}
.search{width:420px;padding:12px 18px;border-radius:30px;border:1px solid #27456d;background:#10203a;color:#fff}
.status{background:#063;color:#7dffbc;padding:8px 14px;border-radius:20px;font-size:13px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:20px}
.card{background:#10203a;border:1px solid #21466f;border-radius:14px;padding:20px}
.card small{color:#8ea8c8}
.card h2{font-size:34px;margin-top:8px}
.blue{color:#39b8ff}.red{color:#ff4d6d}.orange{color:#ffb020}
.panel{background:#10203a;border:1px solid #21466f;border-radius:14px;padding:18px;margin-top:20px}
.chart{height:120px;display:flex;align-items:flex-end;gap:8px;margin-top:16px}
.bar{flex:1;border-radius:8px 8px 0 0;background:linear-gradient(#2ea7ff,#0f5cc4)}
.btn{background:#1d7eff;color:#fff;border:none;padding:12px;border-radius:10px;width:100%;margin-top:14px}
table{width:100%;border-collapse:collapse;margin-top:15px}
th,td{padding:12px;border-bottom:1px solid #234161;font-size:14px;text-align:left}
th{color:#8ea8c8}
.badge{padding:5px 10px;border-radius:18px;font-size:12px}
.critical{background:#7a1630}.high{background:#7a4d00}.medium{background:#164a8a}.low{background:#166534}
.del{background:#dc2626;color:#fff;border:none;padding:7px 10px;border-radius:6px}
.view{color:#39b8ff;text-decoration:none}
@media(max-width:900px){.layout{grid-template-columns:1fr}.sidebar{display:none}.cards{grid-template-columns:1fr}.search{width:100%}}
</style>
</head>
<body>

{% set ns = namespace(critical=0,high=0) %}
{% for i in indicators %}
{% if i.severity_score>=80 %}{% set ns.critical=ns.critical+1 %}
{% elif i.severity_score>=60 %}{% set ns.high=ns.high+1 %}{% endif %}
{% endfor %}

<div class="layout">

<div class="sidebar">
<div class="logo">Threat<span>Lens</span></div>

<div class="menu">
<a class="active" href="#dashboard">🏠 Dashboard</a>
<a href="#feed">📡 IOCs</a>
<a href="#reports">📑 Reports</a>
<a href="#analytics">📊 Analytics</a>
<a href="#settings">⚙ Settings</a>
</div>

<div style="margin-top:40px;padding:15px;background:#10203a;border-radius:12px">
<div style="font-weight:bold;color:#39b8ff">ThreatLens v1.0</div>
<div style="font-size:12px;color:#9fb4cf;margin-top:6px">
Cyber Threat Intelligence Platform
</div>
</div>

</div>

<div class="main">

<div id="dashboard" class="topbar">
<div>
<h1 style="color:#39b8ff">SOC Dashboard</h1>
<div style="color:#9fb4cf;font-size:14px">Real-time Cyber Threat Intelligence</div>
</div>

<div style="display:flex;align-items:center;gap:15px">
<input class="search" placeholder="Search IOC, IP, URL, Domain...">
<div class="status">● System Online</div>
</div>
</div>

<div class="cards">

<div class="card">
<small>Total IOCs</small>
<h2 class="blue">{{ indicators|length }}</h2>
<div style="color:#23d18b;font-size:13px">↑ Active database</div>
</div>

<div class="card">
<small>Critical</small>
<h2 class="red">{{ ns.critical }}</h2>
<div style="color:#ff5f7d;font-size:13px">High priority</div>
</div>

<div class="card">
<small>High Risk</small>
<h2 class="orange">{{ ns.high }}</h2>
<div style="color:#ffb84d;font-size:13px">Requires review</div>
</div>

</div>

<div class="panel">
<h2>📈 IOC Activity Trend</h2>
<div class="chart">
<div class="bar" style="height:25%"></div>
<div class="bar" style="height:40%"></div>
<div class="bar" style="height:55%"></div>
<div class="bar" style="height:48%"></div>
<div class="bar" style="height:72%"></div>
<div class="bar" style="height:85%"></div>
<div class="bar" style="height:100%"></div>
</div>
</div>

<div class="panel">
<h2>➕ Add Threat Indicator</h2>

<form action="/add" method="post">
<p style="margin:8px 0 4px">Indicator</p>
<input name="value" required>

<p style="margin:10px 0 4px">Type</p>
<select name="type">
<option value="ip">IP</option>
<option value="domain">Domain</option>
<option value="url">URL</option>
<option value="hash">Hash</option>
</select>

<p style="margin:10px 0 4px">Severity</p>
<input type="number" name="severity_score" value="90">

<p style="margin:10px 0 4px">Confidence</p>
<input type="number" name="confidence" value="95">

<button class="btn">Add IOC</button>
</form>
</div>

<div id="feed" class="panel">
<h2>📡 Live Threat Feed</h2>

<table>
<tr>
<th>ID</th>
<th>Indicator</th>
<th>Type</th>
<th>Severity</th>
<th>View</th>
</tr>

{% for i in indicators %}
<tr>
<td>{{ i.id }}</td>
<td style="max-width:280px;word-break:break-all">{{ i.value }}</td>
<td>{{ i.type|upper }}</td>
<td>
{% if i.severity_score>=80 %}
<span class="badge critical">Critical</span>
{% elif i.severity_score>=60 %}
<span class="badge high">High</span>
{% elif i.severity_score>=40 %}
<span class="badge medium">Medium</span>
{% else %}
<span class="badge low">Low</span>
{% endif %}
</td>
<td><a class="view" href="/ioc/{{ i.id }}">View</a></td>
</tr>
{% endfor %}
</table>
</div>

<div id="reports" class="panel"><h2>📑 Reports</h2></div>
<div id="analytics" class="panel"><h2>📊 Analytics</h2></div>
<div id="settings" class="panel"><h2>⚙ Settings</h2></div>

</div>
</div>

</body>
</html>
