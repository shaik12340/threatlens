<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Threat Report</title>
<style>
body{font-family:Arial;background:#0b1220;color:#fff;margin:0;padding:30px}
.card{max-width:900px;margin:auto;background:#172033;border-radius:14px;padding:25px}
h1{color:#38bdf8}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:20px}
.item{background:#1e293b;padding:15px;border-radius:10px}
.label{color:#94a3b8;font-size:13px}
.value{margin-top:6px;font-size:16px;font-weight:bold;word-break:break-all}
.critical{color:#ef4444}
.high{color:#f59e0b}
.low{color:#22c55e}
.section{margin-top:25px;padding:18px;background:#111827;border-radius:10px}
.back{display:inline-block;margin-top:25px;padding:10px 18px;background:#2563eb;color:#fff;text-decoration:none;border-radius:8px}
</style>
</head>
<body>

<div class="card">
<h1>🛡 Threat Intelligence Report</h1>
<p>Generated by ThreatLens CTI Dashboard</p>

<div class="grid">

<div class="item">
<div class="label">Indicator</div>
<div class="value">{{ ioc.value }}</div>
</div>

<div class="item">
<div class="label">IOC Type</div>
<div class="value">{{ ioc.type|upper }}</div>
</div>

<div class="item">
<div class="label">Severity</div>
<div class="value critical">{{ ioc.severity_score }}/100</div>
</div>

<div class="item">
<div class="label">Confidence</div>
<div class="value">{{ ioc.confidence }}%</div>
</div>

<div class="item">
<div class="label">Status</div>
<div class="value low">{{ ioc.status|upper }}</div>
</div>

<div class="item">
<div class="label">Threat Source</div>
<div class="value">URLhaus</div>
</div>

</div>

<div class="section">
<h2>🔎 IOC Enrichment</h2>

<div class="items">

<div class="item">
<div class="label">Enrichment Status</div>
<div class="value">{{ ioc.enrichment_status or "pending" }}</div>
</div>

<div class="item">
<div class="label">Reputation</div>
<div class="value">{{ ioc.reputation or "unknown" }}</div>
</div>

<div class="item">
<div class="label">Country</div>
<div class="value">{{ ioc.country or "Unknown" }}</div>
</div>

<div class="item">
<div class="label">ASN</div>
<div class="value">{{ ioc.asn or "Unknown" }}</div>
</div>

<div class="item">
<div class="label">Malware Family</div>
<div class="value">{{ ioc.malware_family or "Unknown" }}</div>
</div>

<div class="item">
<div class="label">Last Seen</div>
<div class="value">{{ ioc.last_seen or "Unknown" }}</div>
</div>

</div>

<button
onclick="enrichIOC()"
style="margin-top:15px;background:#7c3aed;color:white;border:none;padding:10px 18px;border-radius:7px;cursor:pointer;font-weight:600;">
🔍 Enrich IOC
</button>

<span id="enrichMessage" style="margin-left:10px;"></span>

</div>

<script>
async function enrichIOC() {
    const message = document.getElementById("enrichMessage");
    message.textContent = "Enriching...";

    try {
        const response = await fetch("/ioc/{{ ioc.id }}/enrich", {
            method: "POST"
        });

        const data = await response.json();

        if (data.success) {
            message.textContent = "✓ Enrichment completed";
            setTimeout(() => location.reload(), 800);
        } else {
            message.textContent = "✗ Enrichment failed";
        }
    } catch (error) {
        message.textContent = "✗ Request failed";
    }
}
</script>


<div class="section">
<h2>🔗 Related Threats</h2>
<p style="color:#94a3b8">Top correlated indicators detected automatically.</p>

<div id="relatedThreats">
<div style="color:#64748b">Loading correlations...</div>
</div>

</div>

<script>
async function loadCorrelations(){

    const container=document.getElementById("relatedThreats");

    try{

        const res=await fetch("/ioc/{{ ioc.id }}/correlations");
        const data=await res.json();

        if(data.related_count===0){
            container.innerHTML="<div style='color:#64748b'>No related threats found.</div>";
            return;
        }

        let html="";

        data.related_iocs.slice(0,5).forEach(ioc=>{

            const reasons=ioc.reasons.join(", ");

            html += `
            <div style="
                background:#1e293b;
                border-radius:10px;
                padding:14px;
                margin-top:12px;
                border-left:4px solid #8b5cf6;">
                <div style="display:flex;justify-content:space-between;align-items:center">
                    <strong>IOC #${ioc.ioc_id}</strong>
                    <span style="
                        background:#7c3aed;
                        color:white;
                        padding:4px 10px;
                        border-radius:999px;
                        font-size:12px;
                        font-weight:bold;">
                        ${ioc.score}
                    </span>
                </div>

                <div style="
                    color:#cbd5e1;
                    margin-top:8px;
                    word-break:break-all;
                    font-size:13px;">
                    ${ioc.indicator}
                </div>

                <div style="
                    color:#a78bfa;
                    margin-top:8px;
                    font-size:12px;">
                    ${reasons}
                </div>
            </div>`;
        });

        container.innerHTML=html;

    }catch(e){
        container.innerHTML="<div style='color:#ef4444'>Failed to load correlations.</div>";
    }
}

loadCorrelations();
</script>

<div class="section">
<h2>🎯 MITRE ATT&CK Mapping</h2>

{% if ioc.reputation == "benign" %}

<h3>Trusted Infrastructure</h3>
<p>No MITRE ATT&CK technique is applicable for trusted infrastructure.</p>

{% elif ".hta" in ioc.value.lower() %}

<h3>T1218.005 – Mshta</h3>
<p>HTA file may execute malicious code using the Windows Mshta utility.</p>

{% elif ".js" in ioc.value.lower() %}

<h3>T1059.007 – JavaScript</h3>
<p>JavaScript payload can be used for malware execution.</p>

{% elif ioc.reputation == "suspicious" %}

<h3>T1566 – Phishing</h3>
<p>Suspicious URL may be associated with phishing infrastructure.</p>

{% else %}

<h3>T1583 – Infrastructure</h3>
<p>Suspicious infrastructure associated with adversary activity.</p>

{% endif %}</div>

<div class="section">
<h2>📝 Analyst Recommendation</h2>

{% if ioc.reputation == "benign" %}
<ul>
<li>Allow normal access</li>
<li>No blocking required</li>
<li>Monitor only if organizational policy requires logging</li>
</ul>

{% elif ioc.reputation == "suspicious" %}
<ul>
<li>Investigate the domain</li>
<li>Monitor DNS / Web Proxy logs</li>
<li>Submit IOC for analyst review</li>
</ul>

{% else %}
<ul>
<li>Block IOC on Firewall</li>
<li>Block DNS / Web Proxy</li>
<li>Monitor SIEM Alerts</li>
<li>Add IOC to Threat Intelligence Feed</li>
</ul>
{% endif %}</div>


<a href="/ioc/{{ ioc.id }}/pdf" class="back" style="background:#16a34a;margin-right:10px">📄 Download PDF</a>
<a href="/" class="back">⬅ Back Dashboard</a>


</div>
</body>
</html>
