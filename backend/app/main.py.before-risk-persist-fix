@app.post("/ioc/{ioc_id}/enrich")
def enrich_ioc(ioc_id: int, db: Session = Depends(get_db)):
    from app.services.enrichment import enrich_indicator
    from app.services.detection import detect_url
    from app.services.risk import calculate_risk_score

    ioc = db.query(Indicator).filter(Indicator.id == ioc_id).first()

    if not ioc:
        from fastapi import HTTPException
        raise HTTPException(status_code=404, detail="IOC not found")

    ioc.enrichment_status = "processing"
    db.commit()

    try:
        enrichment = enrich_indicator(ioc.value, ioc.type)
        d = detect_url(ioc.value) if ioc.type.lower() == "url" else {"score": 0, "reasons": []}

        ioc.enrichment_status = enrichment.get(
            "enrichment_status", "completed"
        )
        ioc.reputation = enrichment.get(
            "reputation", "unknown"
        )
        ioc.country = enrichment.get("country")
        ioc.asn = enrichment.get("asn")
        ioc.malware_family = enrichment.get("malware_family")
        ioc.last_seen = enrichment.get("last_seen")
        ioc.detection_score = d["score"]
        ioc.detection_reasons = " | ".join(d["reasons"])

        # Phase 10.5 - Risk Aggregation
        all_iocs = db.query(Indicator).all()
        risk = calculate_risk_score(ioc, all_iocs)
        ioc.correlation_score = risk["correlation_score"]
        ioc.risk_score = risk["risk_score"]

        db.commit()
        db.refresh(ioc)

        return {
            "success": True,
            "ioc_id": ioc.id,
            "indicator": ioc.value,
            "risk": {
                "detection_score": risk["detection_score"],
                "correlation_score": risk["correlation_score"],
                "risk_score": risk["risk_score"]
            },
            "enrichment": {
                "status": ioc.enrichment_status,
                "reputation": ioc.reputation,
                "country": ioc.country,
                "asn": ioc.asn,
                "malware_family": ioc.malware_family,
                "last_seen": ioc.last_seen,
            },
        }

    except Exception as e:
        db.rollback()
        ioc.enrichment_status = "failed"
        db.commit()

        from fastapi import HTTPException
        raise HTTPException(
            status_code=500,
            detail=f"IOC enrichment failed: {str(e)}"
        )



@app.get("/ioc/{ioc_id}/correlations")
def get_correlations(ioc_id: int, db: Session = Depends(get_db)):
    current = db.query(Indicator).filter(Indicator.id == ioc_id).first()

    if not current:
        from fastapi import HTTPException
        raise HTTPException(status_code=404, detail="IOC not found")

    all_iocs = db.query(Indicator).all()

    related = []

    for other in all_iocs:
        if other.id == current.id:
            continue

        result = calculate_correlation(current, other)

        if result["score"] > 0:
            related.append({
                "ioc_id": other.id,
                "indicator": other.value,
                "type": other.type,
                "score": result["score"],
                "reasons": result["reasons"]
            })

    related.sort(key=lambda x: x["score"], reverse=True)

    return {
        "source_ioc": current.id,
        "related_count": len(related),
        "related_iocs": related
    }


