@app.get("/")
def dashboard(request: Request, q: str = "", db: Session = Depends(get_db)):
    from app.services.risk import calculate_risk_score

    query = db.query(Indicator)

    if q:
        search = q.strip()
        hostname = urlparse(search).hostname or search

        query = query.filter(
            or_(
                Indicator.value.ilike(f"%{search}%"),
                Indicator.value.ilike(f"%{hostname}%"),
                Indicator.country.ilike(f"%{hostname}%"),
                Indicator.asn.ilike(f"%{hostname}%"),
                Indicator.malware_family.ilike(f"%{hostname}%"),
                Indicator.reputation.ilike(f"%{hostname}%"),
                Indicator.type.ilike(f"%{hostname}%")
            )
        )

        indicators = query.order_by(Indicator.id.desc()).all()

        if len(indicators) == 0 and search.startswith(("http://","https://")):
            from app.services.enrichment import enrich_indicator
            from app.services.detection import detect_url

            e = enrich_indicator(search, "url")
            d = detect_url(search)

            rep = e["reputation"]

            if rep == "malicious":
                severity = 85
            elif rep == "suspicious":
                severity = 50
            elif rep == "benign":
                severity = 10
            else:
                severity = 30

            ioc = Indicator(
                value=search,
                type="url",
                severity_score=severity,
                confidence=90,
                detection_score=d["score"],
                detection_reasons=" | ".join(d["reasons"]),
                status="active",
                enrichment_status=e["enrichment_status"],
                reputation=e["reputation"],
                country=e["country"],
                asn=e["asn"],
                malware_family=e["malware_family"],
                last_seen=e["last_seen"]
            )

            db.add(ioc)
            db.commit()
            db.refresh(ioc)

            return RedirectResponse(f"/ioc/{ioc.id}", status_code=302)

        return templates.TemplateResponse(
            request,
            "dashboard.html",
            {"request": request, "indicators": indicators, "q": q}
        )

    indicators = query.order_by(Indicator.id.desc()).all()

    # Calculate current final risk for dashboard
    all_iocs = db.query(Indicator).all()
    for ioc in indicators:
        risk = calculate_risk_score(ioc, all_iocs)
        ioc.correlation_score = risk["correlation_score"]
        ioc.risk_score = risk["risk_score"]

    return templates.TemplateResponse(
        request,
        "dashboard.html",
        {"request": request, "indicators": indicators, "q": q}
    )

