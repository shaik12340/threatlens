@app.post("/ioc/{ioc_id}/assign")
def assign_ioc(
    ioc_id: int,
    assigned_to: str,
    analyst: str = "SOC Analyst",
    db: Session = Depends(get_db)
):
    from fastapi import HTTPException
    from sqlalchemy import text

    ioc = db.query(Indicator).filter(Indicator.id == ioc_id).first()

    if not ioc:
        raise HTTPException(
            status_code=404,
            detail="IOC not found"
        )

    assigned_to = assigned_to.strip()
    analyst = analyst.strip()

    if not assigned_to:
        raise HTTPException(
            status_code=400,
            detail="assigned_to cannot be empty"
        )

    db.execute(
        text("""
