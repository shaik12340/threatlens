@app.post("/ioc/{ioc_id}/status")
def update_ioc_status(
    ioc_id: int,
    status: str,
    db: Session = Depends(get_db)
):
    from fastapi import HTTPException

    allowed_statuses = {
        "new",
        "investigating",
        "confirmed",
        "contained",
        "resolved"
    }

    new_status = status.strip().lower()

    if new_status not in allowed_statuses:
        raise HTTPException(
            status_code=400,
            detail={
                "message": "Invalid investigation status",
                "allowed_statuses": sorted(allowed_statuses)
            }
        )

    ioc = db.query(Indicator).filter(Indicator.id == ioc_id).first()

    if not ioc:
        raise HTTPException(
            status_code=404,
            detail="IOC not found"
        )

    ioc.status = new_status
    db.commit()
    db.refresh(ioc)

    return {
        "success": True,
        "ioc_id": ioc.id,
        "indicator": ioc.value,
        "status": ioc.status
    }

