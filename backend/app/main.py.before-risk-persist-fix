@app.post("/import/urlhaus")
def import_urlhaus(db: Session = Depends(get_db)):
    try:
        r = httpx.get(
            "https://urlhaus.abuse.ch/downloads/csv_recent/",
            timeout=30
        )
        lines = [x for x in r.text.splitlines() if not x.startswith("#")]
        reader = csv.reader(StringIO("\n".join(lines)))

        added = 0
        for row in reader:
            if len(row) < 3:
                continue

            url = row[2].strip()

            if db.query(Indicator).filter(Indicator.value == url).first():
                continue

            db.add(Indicator(
                value=url,
                type="url",
                severity_score=85,
                confidence=90,
                status="active"
            ))
            added += 1

            if added >= 10:
                break

        db.commit()
        print(f"Imported {added} URLs")

    except Exception as e:
        print("URLHAUS ERROR:", e)

    return RedirectResponse("/", status_code=303)

@app.get("/ioc/{ioc_id}")
def ioc_details(ioc_id: int, request: Request, db: Session = Depends(get_db)):
    from sqlalchemy import text

    ioc = db.query(Indicator).filter(Indicator.id == ioc_id).first()

    if not ioc:
        return RedirectResponse("/", status_code=302)

    investigation = db.execute(
        text("""
            SELECT assigned_to, analyst, created_at
            FROM investigations
            WHERE ioc_id = :ioc_id
            ORDER BY id DESC
            LIMIT 1
        """),
        {"ioc_id": ioc_id}
    ).mappings().first()

    notes = db.execute(
        text("""
            SELECT note, analyst, created_at
            FROM investigation_notes
            WHERE ioc_id = :ioc_id
            ORDER BY id DESC
        """),
        {"ioc_id": ioc_id}
    ).mappings().all()

    actions = db.execute(
        text("""
            SELECT action, analyst, created_at
            FROM investigation_actions
            WHERE ioc_id = :ioc_id
            ORDER BY id DESC
        """),
        {"ioc_id": ioc_id}
    ).mappings().all()

    tags = db.execute(
        text("""
            SELECT tag, added_by, created_at
            FROM investigation_tags
            WHERE ioc_id = :ioc_id
            ORDER BY id DESC
        """),
        {"ioc_id": ioc_id}
    ).mappings().all()

    return templates.TemplateResponse(
        request,
        "ioc_details.html",
        {
            "request": request,
            "ioc": ioc,
            "investigation": investigation,
            "notes": notes,
            "actions": actions,
            "tags": tags
        }
    )

