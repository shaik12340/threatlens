@app.get("/ioc/{ioc_id}/pdf")
def export_pdf(ioc_id: int, db: Session = Depends(get_db)):
    from fastapi.responses import FileResponse
    from reportlab.pdfgen import canvas
    from reportlab.lib.colors import HexColor, white, black
    from reportlab.lib.pagesizes import A4
    from reportlab.pdfbase.pdfmetrics import stringWidth
    import os
    import textwrap
    from datetime import datetime

    ioc = db.query(Indicator).filter(Indicator.id == ioc_id).first()

    if not ioc:
        from fastapi import HTTPException
        raise HTTPException(status_code=404, detail="IOC not found")

    pdf_path = f"/tmp/Threat_Report_{ioc.id}.pdf"

    PAGE_W, PAGE_H = A4
    c = canvas.Canvas(pdf_path, pagesize=A4)

    # =========================
    # COLORS
    # =========================
    NAVY = HexColor("#0B1F33")
    BLUE = HexColor("#1565C0")
    LIGHT_BLUE = HexColor("#EAF3FF")
    CYAN = HexColor("#00A6D6")
    GREEN = HexColor("#0F9D58")
    LIGHT_GREEN = HexColor("#E8F5E9")
    RED = HexColor("#D32F2F")
    LIGHT_RED = HexColor("#FDECEC")
    ORANGE = HexColor("#EF6C00")
    LIGHT_ORANGE = HexColor("#FFF3E0")
    PURPLE = HexColor("#6A1B9A")
    LIGHT_PURPLE = HexColor("#F3E5F5")
    GREY = HexColor("#64748B")
    LIGHT_GREY = HexColor("#F4F7FA")
    BORDER = HexColor("#D9E2EC")
    DARK = HexColor("#17202A")

    # =========================
    # HELPERS
    # =========================
    def rounded_box(x, y, w, h, fill, radius=8, stroke=None):
        c.setFillColor(fill)
        c.setStrokeColor(stroke if stroke else fill)
        c.roundRect(x, y, w, h, radius, fill=1, stroke=1 if stroke else 0)

    def text(x, y, value, font="Helvetica", size=10, color=DARK):
        c.setFont(font, size)
        c.setFillColor(color)
        c.drawString(x, y, str(value))

    def right_text(x, y, value, font="Helvetica", size=10, color=DARK):
        c.setFont(font, size)
        c.setFillColor(color)
        c.drawRightString(x, y, str(value))

    def wrap_text(value, max_width, font="Helvetica", size=9):
        words = str(value).split()
        lines = []
        current = ""

        for word in words:
            test = word if not current else current + " " + word
            if stringWidth(test, font, size) <= max_width:
                current = test
            else:
                if current:
                    lines.append(current)
                current = word

        if current:
            lines.append(current)

        return lines or [""]

    def section_title(y, title, subtitle=None):
        text(42, y, title, "Helvetica-Bold", 15, NAVY)
        c.setStrokeColor(CYAN)
        c.setLineWidth(2)
        c.line(42, y - 7, 112, y - 7)

        if subtitle:
            text(42, y - 23, subtitle, "Helvetica", 8.5, GREY)

    # =========================
    # DATA
    # =========================
    indicator = str(ioc.value)
    ioc_type = str(ioc.type).upper()
    severity = int(ioc.severity_score or 0)
    confidence = int(ioc.confidence or 0)
    status = str(ioc.status or "UNKNOWN").upper()

    if severity >= 80:
        severity_label = "CRITICAL"
        severity_color = RED
        severity_bg = LIGHT_RED
    elif severity >= 60:
        severity_label = "HIGH"
        severity_color = ORANGE
        severity_bg = LIGHT_ORANGE
    elif severity >= 40:
        severity_label = "MEDIUM"
        severity_color = HexColor("#C58B00")
        severity_bg = HexColor("#FFF8E1")
    else:
        severity_label = "LOW"
        severity_color = GREEN
        severity_bg = LIGHT_GREEN

    if ".hta" in indicator.lower():
        mitre_id = "T1218.005"
        mitre_name = "Mshta"
    elif ".js" in indicator.lower():
        mitre_id = "T1059.007"
        mitre_name = "JavaScript"
    elif ".sh" in indicator.lower():
        mitre_id = "T1059.004"
        mitre_name = "Unix Shell"
    elif ioc_type == "IP":
        mitre_id = "T1071"
        mitre_name = "Application Layer Protocol"
    else:
        mitre_id = "T1566"
        mitre_name = "Phishing"

    generated = datetime.now().strftime("%d %b %Y, %H:%M")

    # =========================
    # PAGE BACKGROUND
    # =========================
    c.setFillColor(LIGHT_GREY)
    c.rect(0, 0, PAGE_W, PAGE_H, fill=1, stroke=0)

    # =========================
    # HEADER
    # =========================
    c.setFillColor(NAVY)
    c.rect(0, PAGE_H - 105, PAGE_W, 105, fill=1, stroke=0)

    c.setFillColor(CYAN)
    c.rect(0, PAGE_H - 105, 7, 105, fill=1, stroke=0)

    text(38, PAGE_H - 40, "ThreatLens", "Helvetica-Bold", 25, white)
    text(38, PAGE_H - 60, "Cyber Threat Intelligence Dashboard", "Helvetica", 10, HexColor("#B8D9EF"))

    right_text(PAGE_W - 38, PAGE_H - 38, "SECURITY REPORT", "Helvetica-Bold", 11, white)
    right_text(PAGE_W - 38, PAGE_H - 57, f"IOC #{ioc.id}", "Helvetica", 10, HexColor("#B8D9EF"))
    right_text(PAGE_W - 38, PAGE_H - 75, generated, "Helvetica", 8.5, HexColor("#B8D9EF"))

    # =========================
    # EXECUTIVE SUMMARY
    # =========================
    y = PAGE_H - 140
    section_title(y, "Executive Summary", "Automated threat intelligence assessment")

    y -= 32

    rounded_box(42, y - 68, PAGE_W - 84, 70, white, 9, BORDER)

    summary = (
        f"The indicator associated with IOC #{ioc.id} has been assessed as "
        f"{severity_label.lower()} risk with a confidence level of {confidence}%. "
        f"The indicator was sourced from the URLhaus threat intelligence feed "
        f"and should be reviewed by a security analyst for appropriate containment "
        f"and monitoring actions."
    )

    lines = wrap_text(summary, PAGE_W - 125, "Helvetica", 9.5)
    yy = y - 27

    for line in lines[:4]:
        text(60, yy, line, "Helvetica", 9.5, DARK)
        yy -= 14

    # =========================
    # RISK CARDS
    # =========================
    y -= 78

    card_w = (PAGE_W - 96) / 3
    card_h = 65

    # Severity Card
    rounded_box(42, y - card_h, card_w, card_h, severity_bg, 9)
    text(57, y - 25, "SEVERITY", "Helvetica-Bold", 8, GREY)
    text(57, y - 47, severity_label, "Helvetica-Bold", 14, severity_color)
    right_text(
        42 + card_w - 15,
        y - 47,
        f"{severity}/100",
        "Helvetica-Bold",
        9,
        severity_color
    )

    # Confidence Card
    x2 = 48 + card_w
    rounded_box(x2, y - card_h, card_w, card_h, LIGHT_BLUE, 9)
    text(x2 + 15, y - 25, "CONFIDENCE", "Helvetica-Bold", 8, GREY)
    text(x2 + 15, y - 47, f"{confidence}%", "Helvetica-Bold", 14, BLUE)

    # Status Card
    x3 = 54 + card_w * 2
    rounded_box(x3, y - card_h, card_w, card_h, LIGHT_GREEN, 9)
    text(x3 + 15, y - 25, "STATUS", "Helvetica-Bold", 8, GREY)
    text(x3 + 15, y - 47, status, "Helvetica-Bold", 13, GREEN)

    # =========================
    # IOC DETAILS
    # =========================
    y -= 78
    section_title(y, "IOC Details", "Indicator identification and source information")
    y -= 40

    # IOC details card
    rounded_box(42, y - 135, PAGE_W - 84, 130, white, 9, BORDER)

    details = [
        ("IOC ID", str(ioc.id)),
        ("Indicator Type", ioc_type),
        ("Source", "URLhaus Threat Feed"),
        ("Current Status", status),
    ]

    row_y = y - 27

    for label, value in details:
        text(58, row_y, label, "Helvetica-Bold", 9, GREY)
        right_text(
            PAGE_W - 58,
            row_y,
            value,
            "Helvetica-Bold",
            9,
            DARK
        )

        c.setStrokeColor(BORDER)
        c.setLineWidth(0.5)
        c.line(58, row_y - 9, PAGE_W - 58, row_y - 9)

        row_y -= 23

    # Indicator value
    text(
        58,
        row_y - 2,
        "Indicator Value",
        "Helvetica-Bold",
        9,
        GREY
    )

    clean_indicator = (
        indicator
        .replace("[", "")
        .replace("]", "")
        .replace("(", "")
        .replace(")", "")
    )

    value_lines = wrap_text(
        clean_indicator,
        PAGE_W - 116,
        "Helvetica",
        8.2
    )

    value_y = row_y - 18

    # Show complete indicator value
    for line in value_lines:
        text(
            58,
            value_y,
            line,
            "Helvetica",
            8.5,
            DARK
        )
        value_y -= 12

    # =========================
    # MITRE ATT&CK MAPPING
    # =========================
    # Move MITRE section below the complete Indicator Value
    y = value_y - 20

    section_title(
        y,
        "MITRE ATT&CK Mapping",
        "Potential technique associated with the indicator"
    )

    y -= 34

    # MITRE card
    rounded_box(
        42,
        y - 58,
        PAGE_W - 84,
        53,
        LIGHT_PURPLE,
        9
    )

    # Technique ID badge
    rounded_box(
        58,
        y - 45,
        92,
        30,
        PURPLE,
        7
    )

    text(
        68,
        y - 34,
        mitre_id,
        "Helvetica-Bold",
        10,
        white
    )

    # Technique name
    text(
        165,
        y - 28,
        mitre_name,
        "Helvetica-Bold",
        11,
        NAVY
    )

    text(
        165,
        y - 43,
        "Technique identified from IOC characteristics.",
        "Helvetica",
        7.8,
        GREY
    )

    # =========================
    # RECOMMENDATIONS
    # =========================
    y -= 75
    section_title(y, "Analyst Recommendations", "Recommended SOC response actions")

    y -= 30

    recommendations = [
        "Block the IOC on firewall, proxy and endpoint security controls.",
        "Add the indicator to SIEM / threat-intelligence monitoring.",
        "Monitor DNS and HTTP/HTTPS outbound traffic for related activity.",
        "Perform endpoint investigation for malware or suspicious execution.",
        "Search for related indicators and continue monitoring for recurrence."
    ]

    box_h = 112
    rounded_box(42, y - box_h, PAGE_W - 84, box_h, white, 9, BORDER)

    yy = y - 18

    for i, recommendation in enumerate(recommendations, 1):
        rounded_box(58, yy - 2, 14, 14, BLUE, 7)
        text(62, yy + 1, str(i), "Helvetica-Bold", 6, white)
        text(80, yy, recommendation, "Helvetica", 7.5, DARK)
        yy -= 19

    # =========================
    # FOOTER
    # =========================
    c.setFillColor(NAVY)
    c.rect(0, 0, PAGE_W, 32, fill=1, stroke=0)

    text(38, 12, "ThreatLens CTI Dashboard", "Helvetica-Bold", 8, white)
    right_text(
        PAGE_W - 38,
        12,
        "Confidential • SOC Use Only",
        "Helvetica",
        8,
        HexColor("#B8D9EF")
    )

    c.save()

    return FileResponse(
        pdf_path,
        media_type="application/pdf",
        filename=f"Threat_Report_{ioc.id}.pdf"
    )

